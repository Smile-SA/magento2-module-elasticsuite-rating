<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!-- Register rating filter type provider -->
    <type name="Smile\ElasticsuiteCatalog\Model\Layer\FilterList">
        <arguments>
            <argument name="filterTypeProviders" xsi:type="array">
                <item name="rating" xsi:type="object">Smile\ElasticsuiteRating\Model\Layer\Filter\TypeProvider\Rating</item>
            </argument>
        </arguments>
    </type>

</config>
